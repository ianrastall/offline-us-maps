<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- Windows 11 24H2: the oldest release still serviced for Home and Pro editions (checked November 2026). -->
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <RootNamespace>OfflineMaps.App</RootNamespace>
    <AssemblyName>OfflineMaps</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- Unpackaged: the Windows App SDK and .NET runtimes ship with the app; build/installer.iss installs it. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Required even unpackaged: it adds the app .pri and compiled XAML (.xbf) to publish output. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfflineMaps.Interop\OfflineMaps.Interop.csproj" />
  </ItemGroup>

  <!-- The map page and its local assets, served to WebView2 from the app folder as https://map.local/.
       MapLibre, maplibre-contour and mapbox-gl-rtl-text come from proof/renderer (npm ci), the sprites and glyphs from
       `node proof/renderer/fetch-assets.mjs`, both with pinned hashes. -->
  <PropertyGroup>
    <MapLibreDir>$(RepoRoot)proof\renderer\node_modules\maplibre-gl\</MapLibreDir>
    <ContourDir>$(RepoRoot)proof\renderer\node_modules\maplibre-contour\</ContourDir>
    <RtlTextDir>$(RepoRoot)proof\renderer\node_modules\@mapbox\mapbox-gl-rtl-text\</RtlTextDir>
    <RendererAssetsDir>$(RepoRoot)data\renderer-assets\</RendererAssetsDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(RepoRoot)web\*" Link="Web\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(MapLibreDir)dist\maplibre-gl.mjs;$(MapLibreDir)dist\maplibre-gl-shared.mjs;$(MapLibreDir)dist\maplibre-gl-worker.mjs;$(MapLibreDir)dist\maplibre-gl.css;$(MapLibreDir)LICENSE.txt"
          Link="Web\maplibre\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(ContourDir)dist\index.mjs" Link="Web\contour\maplibre-contour.mjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(ContourDir)LICENSE" Link="Web\contour\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <!-- Right-to-left text (Arabic, Hebrew): bidirectional ordering and Arabic shaping, loaded by the page when such text appears. -->
    <None Include="$(RtlTextDir)dist\mapbox-gl-rtl-text.js;$(RtlTextDir)LICENSE.md" Link="Web\rtl\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(RepoRoot)assets\styles\offline-maps-*.json" Link="Web\styles\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(RendererAssetsDir)sprites\base*" Link="Web\sprites\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(RendererAssetsDir)glyphs\**\*.pbf" Link="Web\glyphs\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(RepoRoot)assets\overview\world-overview.mbtiles" Link="Overview\world-overview.mbtiles" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(RepoRoot)assets\notices\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="RequireMapAssets" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(MapLibreDir)dist\maplibre-gl.mjs')" Text="MapLibre is missing. Run npm ci in proof/renderer." />
    <Error Condition="!Exists('$(ContourDir)dist\index.mjs')" Text="maplibre-contour is missing. Run npm ci in proof/renderer." />
    <Error Condition="!Exists('$(RtlTextDir)dist\mapbox-gl-rtl-text.js')" Text="mapbox-gl-rtl-text is missing. Run npm ci in proof/renderer." />
    <Error Condition="!Exists('$(RendererAssetsDir)glyphs\noto_sans_regular\0-255.pbf') or !Exists('$(RendererAssetsDir)sprites\base.json')" Text="Map sprites or glyphs are missing. Run node proof/renderer/fetch-assets.mjs." />
  </Target>

  <!-- Jupiter style standard 1.1: shared resources, accent service and the style check. -->
  <Import Project="$(RepoRoot)..\jupiter-ui\build\Jupiter.UI.targets" />
</Project>
